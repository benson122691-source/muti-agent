# 複製這個檔案成 .env，再填入自己的值。.env 不要上傳到 GitHub。

# 用哪一家的模型：claude 或 gemini
LLM_PROVIDER=gemini

# 對應的 API 金鑰，填一個就好（沒填的話只能用 V0）
# Gemini：到 Google AI Studio 申請；Claude：到 Claude Console 申請
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# 模型（可不填，依 LLM_PROVIDER 用預設值）
# Gemini 預設：gemini-3.5-flash / gemini-3.1-flash-lite；Claude 預設：claude-sonnet-5-5 / claude-haiku-5-5
# MODEL_STRONG=
# MODEL_FAST=

# 每百萬 token 價格（美元），請到官方價格頁查詢後填入，評估報告才會算出成本
# 用 Gemini 免費方案的話維持 0 即可
PRICE_STRONG_INPUT=0
PRICE_STRONG_OUTPUT=0
PRICE_FAST_INPUT=0
PRICE_FAST_OUTPUT=0
USD_TO_TWD=32

# 每日 LLM 查核上限，超過就自動降級成 V0
MAX_LLM_CHECKS_PER_DAY=200

# 隔離抓取服務的位址
SANDBOX_URL=http://localhost:8001

# 165 開放資料的 CSV 下載網址（到 data.gov.tw 資料集頁面複製 CSV 下載連結）
URL_165_FAKE_INVEST_CSV=
URL_165_SUSPENDED_DOMAINS_CSV=
